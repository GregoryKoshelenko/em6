{
  "version": 1,
  "author": "Gregory Koshelenko (GK)",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-devkitc-1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr", "top": -120, "left": -260, "attrs": {} },
    { "type": "wokwi-led", "id": "led", "top": -80, "left": 200, "attrs": { "color": "yellow" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 20, "left": 190, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "ldr:AO", "esp:9", "green", [] ],
    [ "ldr:VCC", "esp:3V3.1", "red", [] ],
    [ "ldr:GND", "esp:GND.1", "black", [] ],
    [ "esp:2", "r1:2", "gold", [] ],
    [ "r1:1", "led:A", "gold", [] ],
    [ "led:C", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
